# Indexer API
HOST=0.0.0.0
PORT=3000

# CORS (comma-separated or * for all — default all)
# CORS_ORIGIN=http://localhost:5173
# Set TRUST_PROXY=1 (or higher number) only when the indexer is behind a trusted reverse proxy.
TRUST_PROXY=0

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
