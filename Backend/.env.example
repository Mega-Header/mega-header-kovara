NODE_ENV=development

# PostgreSQL
POSTGRES_USER=mega-header-mega-header-mega-header-kovara
POSTGRES_PASSWORD=mega-header-mega-header-mega-header-kovara
POSTGRES_DB=mega-header-mega-header-mega-header-kovara
DATABASE_URL=postgresql://mega-header-mega-header-mega-header-kovara:mega-header-mega-header-mega-header-kovara@postgres:5432/mega-header-mega-header-mega-header-kovara

# Stellar
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Required. Replace with the deployed mega-header-mega-header-mega-header-kovara contract address: a 56-character
# Stellar strkey beginning with C. Startup fails if this is missing or malformed.
CONTRACT_ID=
# Optional, defaults to 0. Must be a non-negative integer ledger sequence.
START_LEDGER=0

# Indexer API
HOST=0.0.0.0
PORT=3000

# CORS (comma-separated or * for all — default all)
# CORS_ORIGIN=http://localhost:5173
# Set TRUST_PROXY=1 (or higher number) only when the indexer is behind a trusted reverse proxy.
TRUST_PROXY=0

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Per-address rate limiting (Issue #616)
# Limits requests keyed by the Stellar wallet address extracted from the URL
# param, request body, or x-stellar-address header. Requests with no
# identifiable address fall back to the IP-based limiter above.
ADDRESS_RATE_LIMIT_WINDOW_MS=60000
ADDRESS_RATE_LIMIT_MAX=100
