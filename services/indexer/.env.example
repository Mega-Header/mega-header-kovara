NODE_ENV=development

# PostgreSQL
POSTGRES_USER=mega-header-mega-header-mega-header-kovara
POSTGRES_PASSWORD=mega-header-mega-header-mega-header-kovara
POSTGRES_DB=mega-header-mega-header-mega-header-kovara
DATABASE_URL=postgresql://mega-header-mega-header-mega-header-kovara:mega-header-mega-header-mega-header-kovara@postgres:5432/mega-header-mega-header-mega-header-kovara

# Stellar
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
